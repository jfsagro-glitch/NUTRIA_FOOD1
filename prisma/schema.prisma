// Prisma Schema — NÜTRIA v0.2 (MVP CRM)
// Добавлены CRM-модели поверх существующих food diary моделей

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Пользователи ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // NUTRITIONIST — нутрициолог (CRM), CLIENT — клиент, ADMIN — администратор
  role         String   @default("CLIENT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Связи food diary (существующие)
  meals                  Meal[]
  nutrientGoals          NutrientGoal?
  recognitionCorrections RecognitionCorrection[]

  // Связи CRM (новые)
  nutritionistProfile NutritionistProfile?
  clientProfile       ClientProfile?
  clientNotes         ClientNote[]         @relation("NutritionistNotes")
  recommendations     Recommendation[]     @relation("NutritionistRecs")
  invitesSent         ClientInvite[]       @relation("InvitedBy")
  inviteReceived      ClientInvite?        @relation("InvitedClient")
  analyses            AnalysisFile[]       @relation("NutritionistAnalyses")
  consultationDates   ConsultationDate[]   @relation("NutritionistConsultations")

  // Связь с Telegram-ботом (новое)
  telegramAccount     TelegramAccount?
  telegramLinkCodes   TelegramLinkCode[]

  // Связи "Мои" / Недавние (новое, v0.3)
  customProducts      Product[]            @relation("UserProducts")
  recipes             Recipe[]
  recentFoods         RecentFood[]

  // Сообщения нутрициолог ↔ клиент (новое)
  messagesAsNutritionist Message[] @relation("NutritionistMessages")
  messagesAsClient       Message[] @relation("ClientMessages")

  // Трекер активности (новое, Sprint 2)
  activityLogs ActivityLog[]
  weightLogs   WeightLog[]

  // Планы питания CRM (новое, Sprint 4)
  mealPlansAsNutritionist MealPlan[] @relation("NutritionistMealPlans")
}

// ─── Профиль нутрициолога ────────────────────────────────────────────────────

model NutritionistProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  specialization String?
  phone          String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Приглашение клиента ─────────────────────────────────────────────────────

// Приглашение — универсальное: раньше только для клиента, теперь админ может пригласить
// пользователя с любой ролью (CLIENT/NUTRITIONIST/ADMIN) по email. Название модели/поля
// nutritionistId сохранены как есть (кто пригласил — не обязательно нутрициолог, может
// быть админ), чтобы не переименовывать таблицу лишний раз.
model ClientInvite {
  id              String    @id @default(cuid())
  // Кто создал приглашение (нутрициолог — для клиентских инвайтов, админ — для любых)
  nutritionistId  String
  nutritionist    User      @relation("InvitedBy", fields: [nutritionistId], references: [id], onDelete: Cascade)
  // Приглашённый пользователь (заполняется после онбординга)
  clientId        String?   @unique
  client          User?     @relation("InvitedClient", fields: [clientId], references: [id])
  // Уникальный токен в ссылке: /onboard/:token
  token           String    @unique @default(cuid())
  // Секретная фраза для входа клиента (для CLIENT-приглашений; для NUTRITIONIST/ADMIN
  // генерируется случайно и не используется — там вход по email+паролю после онбординга)
  secretPhrase    String
  // Имя приглашённого (может быть задано заранее)
  clientName      String?
  // Email приглашённого — обязателен для NUTRITIONIST/ADMIN-приглашений (используется как
  // email создаваемого User), опционален для CLIENT (если не задан — используется
  // синтетический client-<id>@nutria.internal, как раньше)
  email           String?
  // Роль, которую получит приглашённый после онбординга: CLIENT | NUTRITIONIST | ADMIN
  role            String    @default("CLIENT")
  // Теги
  tagsJson        String?   @default("[]")
  // Статус
  status          String    @default("PENDING") // PENDING | ACTIVE | ARCHIVED
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nutritionistId])
}

// ─── Анкета клиента ──────────────────────────────────────────────────────────

model ClientProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Блок 1 — базовые данные
  firstName  String?
  lastName   String?
  birthYear  Int?
  sex        String?  // male | female
  heightCm   Float?
  weightKg   Float?
  goal       String?  // lose | maintain | gain | recomposition
  activity   String?  // low | moderate | high | very_high

  // История веса (JSON array [{date, kg}])
  weightHistoryJson String? @default("[]")

  // Блок 2 — расширенные данные
  sleepQuality    String?
  badHabits       String?
  dietRestrictions String? // vegetarian, vegan, post, etc.
  allergiesJson   String?  @default("[]") // ["gluten","lactose","nuts"]
  chronicDiseases String?
  surgeries       String?
  medications     String?
  complaints      String?
  gutHealth       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Приватные заметки нутрициолога ─────────────────────────────────────────

model ClientNote {
  id             String   @id @default(cuid())
  // Нутрициолог
  nutritionistId String
  nutritionist   User     @relation("NutritionistNotes", fields: [nutritionistId], references: [id], onDelete: Cascade)
  // Клиент
  clientId       String
  // Контекст (day/meal/analysis — опционально)
  context        String?  // e.g. "2026-06-18" or "analysis:abc123"
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([nutritionistId, clientId])
}

// ─── Анализы клиента ─────────────────────────────────────────────────────────

model AnalysisFile {
  id             String   @id @default(cuid())
  nutritionistId String
  nutritionist   User     @relation("NutritionistAnalyses", fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  fileName       String
  mimeType       String
  // Base64 содержимое (для MVP; в продакшене заменить на S3 URL)
  dataBase64     String
  note           String?
  takenAt        DateTime // дата взятия анализа
  createdAt      DateTime @default(now())

  @@index([nutritionistId, clientId])
}

// ─── Рекомендации нутрициолога ───────────────────────────────────────────────

model Recommendation {
  id             String   @id @default(cuid())
  nutritionistId String
  nutritionist   User     @relation("NutritionistRecs", fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([nutritionistId, clientId])
}

// ─── Даты консультаций ───────────────────────────────────────────────────────

model ConsultationDate {
  id             String   @id @default(cuid())
  nutritionistId String
  nutritionist   User     @relation("NutritionistConsultations", fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  scheduledAt    DateTime
  note           String?
  createdAt      DateTime @default(now())

  @@index([nutritionistId])
}

// ─── Сообщения нутрициолог ↔ клиент (новое) ─────────────────────────────────

model Message {
  id             String    @id @default(cuid())
  nutritionistId String
  nutritionist   User      @relation("NutritionistMessages", fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  client         User      @relation("ClientMessages", fields: [clientId], references: [id], onDelete: Cascade)
  sender         String    // "NUTRITIONIST" | "CLIENT"
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([nutritionistId, clientId])
  @@index([clientId])
}

// ─── Telegram-бот (новое) ────────────────────────────────────────────────────

model TelegramAccount {
  id        String   @id @default(cuid())
  // chat.id из Telegram Update — уникальный идентификатор диалога
  chatId    String   @unique
  username  String?
  firstNameTg String?

  // Привязанный аккаунт NÜTRIA (создаётся после завершения онбординга)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Состояние диалога (машина состояний онбординга/команд)
  state     String   @default("NEW")
  // Временные ответы во время онбординга / промежуточные данные команд (JSON)
  draftJson String?  @default("{}")
  // Настраиваемые напоминания о заполнении дневника, JSON-массив строк "HH:MM"
  remindersJson String? @default("[]")

  // Умные напоминания: если приём пищи не внесён через N часов после
  // типичного времени (завтрак/обед/ужин), бот сам напомнит об этом.
  smartRemindersEnabled  Boolean @default(false)
  // Максимум умных напоминаний в день — настраивается клиентом в ЛК бота.
  smartReminderMaxPerDay Int     @default(3)
  // Состояние на текущие сутки: {"date":"YYYY-MM-DD","sentMeals":["BREAKFAST"],"sentCount":1}
  smartReminderStateJson String? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Одноразовый код для привязки уже существующего веб-аккаунта к Telegram-чату
// (Профиль → Настройки → Telegram-уведомления → код/диплинк → /start <code> в боте).
model TelegramLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Существующие модели (без изменений) ─────────────────────────────────────

model Product {
  id             String     @id @default(cuid())
  name           String
  brand          String?
  barcode        String?    @unique
  calories       Float
  protein        Float
  fat            Float
  carbs          Float
  fiber          Float?
  micronutrients String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  mealItems      MealItem[]
  recognitionCorrections RecognitionCorrection[]

  // ─── "Мои" продукты и блюда (новое, v0.3) ──────────────────────────────────
  // catalog (общая база) | off (Open Food Facts) | ai (распознано AI) | user (свой продукт) | recipe (блюдо из "Мои")
  source           String   @default("catalog")
  createdByUserId  String?
  createdByUser    User?    @relation("UserProducts", fields: [createdByUserId], references: [id])
  // Если этот Product — "снимок" пользовательского блюда, ссылка на Recipe
  recipeId         String?  @unique
  recipe           Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recentFoods      RecentFood[]
  recipeIngredients RecipeIngredient[]
  mealPlanItems     MealPlanItem[]

  @@unique([name, brand])
}

// ─── "Мои блюда" — пользовательские рецепты из ингредиентов (новое, v0.3) ───

model Recipe {
  id                         String             @id @default(cuid())
  userId                     String
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  totalIngredientWeightGrams Float
  cookedWeightGrams          Float
  ingredients                RecipeIngredient[]
  // 1:1 со "снимком"-продуктом, который реально кладётся в дневник
  product                    Product?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([userId])
}

model RecipeIngredient {
  id          String  @id @default(cuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  weightGrams Float
  calories    Float
  protein     Float
  fat         Float
  carbs       Float
}

// ─── "Недавние" продукты/блюда (новое, v0.3) ────────────────────────────────

model RecentFood {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lastWeightGrams Float?
  useCount        Int      @default(1)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, lastUsedAt])
}

model RecognitionCorrection {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceName         String
  normalizedSource   String
  aliasesJson        String?
  visibleTextJson    String?
  correctedProductId String
  correctedProduct   Product  @relation(fields: [correctedProductId], references: [id])
  usageCount         Int      @default(1)
  lastUsedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, normalizedSource])
  @@unique([userId, normalizedSource, correctedProductId])
}

model Meal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  date      DateTime   @default(now())
  items     MealItem[]
  createdAt DateTime   @default(now())

  // TODO: добавить @@unique([userId, type, date]) + @@index([userId, date]) — защитит
  // от дублей Meal при параллельных клиентах (веб-вкладка + Telegram-бот, двойной тап),
  // но требует ручного db:dedupe:meals + `prisma db push --accept-data-loss` на проде
  // ПЕРЕД тем, как это попадёт в обычный автодеплой (см. prisma/dedupe-meals.ts) —
  // иначе plain `db push` в scripts/start-server.mjs упадёт и уронит весь деплой.
}

model MealItem {
  id        String  @id @default(cuid())
  mealId    String
  meal      Meal    @relation(fields: [mealId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  amount    Float
}

// ─── Трекер физической активности (новое, Sprint 2) ─────────────────────────
// caloriesBurned считается на клиенте (MET × вес × часы) из профиля в localStorage,
// сервер только хранит готовое значение — по той же схеме, что и NutrientGoal.
model ActivityLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  activityName     String
  durationMinutes  Float
  caloriesBurned   Float
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

// ─── Трекер веса тела (новое, Sprint 2) ──────────────────────────────────────
// Одна запись на день: повторная запись в тот же день обновляет значение (upsert),
// а не плодит дубликаты — см. @@unique([userId, date]).
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Планы питания CRM (новое, Sprint 4) ─────────────────────────────────────
// Нутрициолог составляет недельный план блюд для клиента; каждая позиция плана —
// продукт + граммовка (как MealItem в дневнике), привязанная к дню недели и приёму пищи.
// Список покупок строится агрегацией всех MealPlanItem плана.
model MealPlan {
  id             String         @id @default(cuid())
  nutritionistId String
  nutritionist   User           @relation("NutritionistMealPlans", fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  title          String
  weekStartDate  DateTime
  items          MealPlanItem[]
  createdAt      DateTime       @default(now())

  @@index([nutritionistId, clientId])
}

model MealPlanItem {
  id          String   @id @default(cuid())
  planId      String
  plan        MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 (Пн) .. 6 (Вс)
  mealType    String // BREAKFAST | LUNCH | DINNER | SNACK
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  amountGrams Float

  @@index([planId])
}

model NutrientGoal {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Float
  protein  Float
  fat      Float
  carbs    Float
  fiber    Float?
}
