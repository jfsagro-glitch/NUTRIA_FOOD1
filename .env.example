# .env.example
GEMINI_API_KEY=
USDA_FDC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_PROXY_URL=
OPENAI_ORG=
OPENAI_PROJECT=

# DATABASE_URL: Required for Prisma PostgreSQL connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# JWT_SECRET / COOKIE_SECRET: required in production — the server refuses to start
# without them (a missing secret would let sessions be forged). Generate with e.g.
# `openssl rand -hex 32`. Keep both stable across deploys/restarts, otherwise all
# active sessions are invalidated.
JWT_SECRET=
COOKIE_SECRET=

# Barcode / QR lookup tuning (Russia-first)
BARCODE_PREFERRED_COUNTRY=ru
BARCODE_PREFERRED_LANG=ru
BARCODE_LOOKUP_TIMEOUT_MS=3500
BARCODE_CACHE_TTL_MS=21600000
