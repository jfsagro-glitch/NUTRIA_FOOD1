# .env.example
GEMINI_API_KEY=
USDA_FDC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_PROXY_URL=
OPENAI_ORG=
OPENAI_PROJECT=

# DATABASE_URL: Required for Prisma PostgreSQL connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Barcode / QR lookup tuning (Russia-first)
BARCODE_PREFERRED_COUNTRY=ru
BARCODE_PREFERRED_LANG=ru
BARCODE_LOOKUP_TIMEOUT_MS=3500
BARCODE_CACHE_TTL_MS=21600000
