{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && tsc && vite build",
    "start": "node scripts/start-server.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:backfill:micronutrients": "tsx prisma/backfill-micronutrients.ts",
    "db:seed:servings": "tsx prisma/seed-servings.ts",
    "db:dedupe:meals": "tsx prisma/dedupe-meals.ts",
    "db:localize:ru": "tsx prisma/localize-ru.ts",
    "smoke:photo-correction": "powershell -ExecutionPolicy Bypass -File scripts/smoke-photo-correction.ps1",
    "smoke:photo-whole-dish": "powershell -ExecutionPolicy Bypass -File scripts/smoke-photo-whole-dish.ps1",
    "benchmark:recognition": "tsx benchmarks/run-recognition-benchmark.ts",
    "benchmark:validate": "tsx benchmarks/validate-recognition-dataset.ts",
    "benchmark:import-usda": "tsx benchmarks/import-usda-references.ts",
    "benchmark:expand": "tsx benchmarks/expand-recognition-dataset.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-levenshtein": "^3.0.0",
    "helmet": "^8.2.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.0",
    "openai": "^6.25.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "undici": "^7.24.4",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
